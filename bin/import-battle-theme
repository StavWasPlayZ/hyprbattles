#!/usr/bin/env python3
"""Decode an audio file into the battle theme you supply yourself.

The repository ships a theme of its own, generated by bin/make-battle-audio.
This is for replacing it with something else - anything a player will not
open, because `aplay`, `paplay` and `pw-play` only understand PCM and the
daemon picks whichever of them is installed.

The result goes **outside the checkout**, into the custom assets directory,
so a clone stays clean however much music ends up in it:

    ~/.config/omarchy/hyprbattles/assets/battle-theme.source.<ext>
    ~/.config/omarchy/hyprbattles/assets/battle-theme.wav

    bin/import-battle-theme                     # re-decode the saved source
    bin/import-battle-theme ~/some-track.mp3    # take a new one

In `auto` - the default - a file there simply wins over the generated one,
for that name only. `bin/hyprbattles-ctl assets` says which of the two every
sound came out of, and `bin/hyprbattles-ctl assets generated` puts the shipped
theme back without moving anything.

What you put there, and whether you have the right to, is between you and
whoever wrote it. Nothing under this directory can reach the repository.
"""

import glob
import os
import shutil
import subprocess
import sys
import wave

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(PLUGIN_ROOT, "lib"))
import battle_assets                                        # noqa: E402

ASSETS = battle_assets.custom_dir()
TARGET = os.path.join(ASSETS, "battle-theme.wav")


def saved_source():
    """Whatever was imported last, whatever it was encoded as."""
    found = sorted(glob.glob(os.path.join(ASSETS, "battle-theme.source.*")))
    return found[0] if found else None


def main(argv):
    source = argv[1] if len(argv) > 1 else saved_source()

    if not shutil.which("ffmpeg"):
        print("import-battle-theme: ffmpeg is needed to decode the theme",
              file=sys.stderr)
        return 1
    if not source:
        print("import-battle-theme: nothing imported yet - give me a file",
              file=sys.stderr)
        return 1
    if not os.path.exists(source):
        print("import-battle-theme: no such file: %s" % source, file=sys.stderr)
        return 1

    os.makedirs(ASSETS, exist_ok=True)

    # A file handed in from elsewhere is kept beside the asset, so the theme
    # survives the download directory being cleared and can be decoded again
    # without being found a second time.
    kept = os.path.join(ASSETS, "battle-theme.source%s"
                        % os.path.splitext(source)[1].lower())
    if os.path.abspath(source) != os.path.abspath(kept):
        for stale in glob.glob(os.path.join(ASSETS, "battle-theme.source.*")):
            if os.path.abspath(stale) != os.path.abspath(kept):
                os.unlink(stale)
        shutil.copyfile(source, kept)

    # Straight decode: CD rate, stereo, no metadata. Nothing is trimmed, so a
    # track that was written to loop still loops.
    subprocess.run(
        ["ffmpeg", "-hide_banner", "-v", "error", "-y", "-i", kept,
         "-map", "0:a:0", "-ac", "2", "-ar", "44100", "-c:a", "pcm_s16le",
         "-map_metadata", "-1", TARGET],
        check=True)

    with wave.open(TARGET) as handle:
        seconds = handle.getnframes() / float(handle.getframerate())
    print("battle-theme.wav   %5.1fs   %s" % (seconds, TARGET))
    print("`hyprbattles-ctl assets` to check it is the one that will play.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
