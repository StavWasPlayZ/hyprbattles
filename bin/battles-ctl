#!/usr/bin/env python3
"""Ask the window-battles daemon what it is doing, or tell it what to do.

    battles-ctl                 # the battle on screen as JSON, or inactive
    battles-ctl enabled         # "true" or "false", for a menu `checked:` line
    battles-ctl on|off|toggle   # turn battles on or off, remembered across
                                # restarts. Works with the daemon stopped: the
                                # setting is a file, not a running process.
    battles-ctl cancel          # flee it, or close an over one (what Escape does)
    battles-ctl stop            # tear it down at once, without the closing line
    battles-ctl debug           # force one between the focused window and its
                                # neighbour, for working on the overlay

    battles-ctl pantry          # what is on the shelves right now: a live,
                                # read-only reading of the machine

    battles-ctl assets          # which sound is coming from which file, and
                                # why. The thing to run when your own file is
                                # not playing.
    battles-ctl assets auto|generated|custom
                                # auto      your file when there is one, the
                                #           generated one when there is not,
                                #           decided per file. The default.
                                # generated only what ships, even with your
                                #           files sitting there: the A/B
                                #           position, no files moved.
                                # custom    only your files. A name you have
                                #           not supplied is silent.
                                # HYPRBATTLES_ASSETS=<mode> overrides the
                                # saved setting for one process.

    battles-ctl move <dir>      # left|right|up|down: move the focused window
                                # one cell and, if that landed on another
                                # window, roll for a battle. This is what a
                                # move key should be bound to; it moves the
                                # window whether or not battles are on, and
                                # whether or not the daemon is running.

    battles-ctl key <name>      # left|right|up|down|confirm|back|leave, the
                                # overlay's keyboard mapped onto the controls

    battles-ctl pick [n]        # play move n of the battle on screen, and
    battles-ctl advance         # step the text on: both debug aids, so the
                                # overlay can be driven without a controller

Turning battles off stops any battle from starting at all; it is checked
before the roll. A battle already on screen ends when it is switched off.
"""

import json
import os
import socket
import sys

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(PLUGIN_ROOT, "lib"))
# The exceptions to this script importing nothing, and both for the same
# reason: a second copy of one of these answers would be a second answer.
# Which file a sound comes from is the whole point of `battles-ctl assets`,
# and how a window is moved has to be what the daemon would have done, or a
# move made with the daemon down would land differently from one made with it
# up. All three are pure stdlib and do nothing at import.
import battle_assets                                        # noqa: E402
import hyprland                                             # noqa: E402
import window_moves as moves                                # noqa: E402

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
SOCKET_PATH = os.path.join(RUNTIME_DIR, "hyprscroll2d-battle.sock")
STATE_HOME = (os.environ.get("XDG_STATE_HOME")
              or os.path.expanduser("~/.local/state"))
# Presence means off. The file is the setting - not the daemon - so the menu
# row can read and flip it while the shell is restarting, or before the daemon
# has ever run. The daemon reads the same file on every collision.
DISABLED_FLAG = os.path.join(STATE_HOME, "hyprscroll2d", "battles-disabled")

COMMANDS = ("status", "enabled", "on", "off", "toggle", "cancel", "stop",
            "debug", "pantry", "assets", "pick", "advance", "key", "move")
# These work without a daemon; the rest need one. `move` is not among them
# because a daemon is what makes a move a battle - but it is the one command
# that still does its job without one, by making the move itself.
OFFLINE = ("enabled", "on", "off", "toggle", "assets")


def describe(amount, unit):
    """A reading as something short enough for a column. Kept in step with
    pantry.describe(); this script deliberately imports nothing."""
    if unit == "MiB":
        if amount >= 1024:
            return "%.1f GiB" % (amount / 1024.0)
        return "%d MiB" % int(amount)
    if unit:
        return "%d %s" % (int(amount), unit)
    return "%d" % int(amount)


def assets(argv):
    """Set the assets mode, or say what every sound is resolving to and why.

    The listing is the point of the command. "My file is not playing" has
    three ordinary causes - the mode is `generated`, the name is not one the
    daemon ever asks for, or the file is not where it needs to be - and all
    three are visible in the same three columns.
    """
    if argv:
        error = battle_assets.set_mode(argv[0].strip().lower())
        if error:
            print(error, file=sys.stderr)
            return 2
        # A running daemon reads the mode on each play, so this is only to end
        # a battle mid-theme cleanly; nothing depends on it arriving.
        nudge()

    override = battle_assets.override_mode()
    saved = battle_assets.saved_mode()
    active = override or saved
    if override and override != saved:
        print("mode       %-10s (%s, overriding the saved %s)"
              % (active, battle_assets.ENV_VAR, saved))
    else:
        print("mode       %s" % active)
    print("generated  %s" % battle_assets.GENERATED)
    print("custom     %s" % battle_assets.custom_dir())
    print()
    for name, path, source in battle_assets.resolution(active):
        print("%-19s %-10s %s" % (name, source, path or "- nothing to play -"))
    return 0


def enabled():
    return not os.path.exists(DISABLED_FLAG)


def set_enabled(wanted):
    try:
        if wanted:
            os.unlink(DISABLED_FLAG)
        else:
            os.makedirs(os.path.dirname(DISABLED_FLAG), exist_ok=True)
            open(DISABLED_FLAG, "w").close()
    except FileNotFoundError:
        pass                    # already off, or already on
    except OSError as error:
        print("cannot save the setting: %s" % error, file=sys.stderr)
        return False
    return True


def nudge():
    """Best effort: tell a running daemon the setting moved, so it can end a
    battle that is on screen. Nothing to do if it is not running."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
            client.settimeout(0.3)
            client.sendto(b"refresh", SOCKET_PATH)
    except OSError:
        pass


def ask(message):
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
        client.bind("")             # abstract autobind, so the reply lands here
        client.settimeout(1.0)
        client.sendto(message.encode(), SOCKET_PATH)
        return json.loads(client.recv(8192).decode())


def move(direction):
    """Move the focused window with no daemon to do it for us.

    The keybind must not die with the shell: a restart is a few seconds in
    which a move key that does nothing would be far more annoying than a
    missed battle. Nothing rolls here - there is nobody to run a fight - so
    this is only the move, made exactly the way the daemon would have made it.
    """
    direction = direction.strip().lower()
    if direction not in moves.DIRECTIONS:
        print("unknown direction: %s" % direction, file=sys.stderr)
        return 2
    hypr = hyprland.Hyprland()
    layout = moves.layout_name(hypr.query("getoption general:layout"))
    for style in moves.order(layout):
        before = moves.placement(hypr.query("clients") or [])
        hypr.dispatch(moves.command(style, direction))
        if moves.placement(hypr.query("clients") or []) != before:
            break               # it landed; the other style would move it back
    return 0


def main(argv):
    argument = (argv[1] if len(argv) > 1 else "status").lower()
    if argument in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argument not in COMMANDS:
        print("unknown command: %s" % argument, file=sys.stderr)
        return 2

    # The switch is a file, so reading and flipping it never needs the daemon.
    # That matters: the menu row's `checked` condition has to answer while the
    # shell is restarting, and turning battles off has to work then too.
    if argument == "assets":
        return assets(argv[2:])

    if argument in OFFLINE:
        if argument != "enabled":
            wanted = not enabled() if argument == "toggle" else argument == "on"
            if not set_enabled(wanted):
                return 1
            nudge()
        print("true" if enabled() else "false")
        return 0

    message = (" ".join([argument] + argv[2:])
               if argument in ("pick", "key", "move") else argument)
    try:
        state = ask(message)
    except (OSError, ValueError):
        if argument == "move":
            return move(argv[2] if len(argv) > 2 else "")
        print("window battles daemon is not running", file=sys.stderr)
        return 1

    if argument == "move":
        return 0                # the daemon moved it, and rolled for it

    if argument == "pantry":
        shelves = state.get("pantry") or []
        if not shelves:
            print("the pantry is empty")
            return 0
        for shelf in shelves:
            print("%-12s %-11s %3d servings   %s" % (
                shelf["name"],
                describe(shelf["available"], shelf["unit"]),
                shelf["servings"], shelf["note"]))
        return 0

    print(json.dumps(state))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
