#!/usr/bin/python3 -I
"""Run window battles: spot a window colliding with another, roll, fight.

This daemon owns the whole feature. It waits for one window to be thrown into
another, rolls the odds, and on a hit borrows the pad, runs a turn-based fight
between the two windows and publishes it for the overlay (Battle.qml) to draw.

A collision reaches it two ways, and it needs no plugin for either:

  * it moves the window itself, on `hyprbattles-ctl move <direction>`, and sees
    the swap in Hyprland's own window list. That works on dwindle, on master
    and on a scrolling layout alike - lib/window_moves.py is the whole of the
    difference between them;
  * or a layout plugin announces the collision as a custom event, which is
    what Demon Slayer's Hyprscroll2D does, and the gamepad plugin repeats for
    pad-driven moves only.

Both optional plugins are reached through Hyprland's own sockets and neither
is imported, linked against or looked for on disk, so a missing one costs a
trigger path rather than raising an error.

The rules are in lib/battle_rules.py, which has no I/O in it at all; this file
is the wiring, and Battle.qml is the picture. Nothing here can do more to a
window than ask the layout to move it one cell.

No third-party Python modules.
"""

import ctypes
import json
import os
import random
import selectors
import signal
import socket
import subprocess
import sys
import time

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(PLUGIN_ROOT, "lib"))
import battle_assets                                       # noqa: E402
import battle_rules as rules                                # noqa: E402
import creatures                                           # noqa: E402
import hyprland                                            # noqa: E402
import pantry                                              # noqa: E402
import runtime                                             # noqa: E402
import tools                                               # noqa: E402
import window_moves as moves                               # noqa: E402

PR_SET_PDEATHSIG = 1

# $XDG_RUNTIME_DIR, or a private directory of this user's own - never /tmp,
# where a predictable name is an invitation. lib/runtime.py is the whole of
# that decision, and of how anything in there is written: the directory is
# opened once, checked, and every file is made relative to that descriptor.
RUNTIME_DIR = runtime.runtime_dir()
STATE_HOME = runtime.STATE_HOME

STATE_NAME = "hyprscroll2d-battle.json"
SOCKET_NAME = "hyprscroll2d-battle.sock"
STATE_PATH = os.path.join(RUNTIME_DIR, STATE_NAME)
SOCKET_PATH = os.path.join(RUNTIME_DIR, SOCKET_NAME)
# The gamepad plugin's control socket, which is also where a lease is asked
# for. Only the path is shared; nothing else about that plugin is known here,
# and nothing is ever created at it - it is where that plugin listens, so it
# is looked for where that plugin puts it, its own fallback included.
GAMEPAD_SOCKET = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "hyprscroll2d-gamepad.sock")

# Presence of the flag means battles are off, matching the way the bar toggle
# and the minimap remember themselves.
DISABLED_FLAG = os.path.join(STATE_HOME, "hyprscroll2d", "battles-disabled")
# Presence means a move has reached the plugin at least once, by either
# trigger path, on this machine ever. Its absence is the one thing the panel
# can say out loud that a fresh install needs to hear: battles wait on a move
# key routed through `hyprbattles-ctl move`, and until one is there a window
# shoved into another window does nothing at all. A file rather than a count
# because the question is only ever "has this ever worked", and because the
# CLI answers it with the daemon down - which is exactly when a keybind that
# was never bound looks the same as one that was.
REACHED_FLAG = os.path.join(STATE_HOME, "hyprscroll2d", "move-seen")
# What has been eaten lately and has not grown back yet. See lib/pantry.py:
# the food is a live reading of the machine, and this is the only thing that
# stops the same 512 MiB being fed to a creature over and over.
LEDGER_PATH = os.path.join(STATE_HOME, "hyprscroll2d", "pantry.json")
# What every window class has earned: levels, wins, moves, the hours its
# windows have been open and everything it has ever eaten. See
# lib/creatures.py - all of it belongs to the class, so all of it outlives
# any one window and the machine being restarted.
CREATURES_PATH = creatures.STORE_PATH
BAR_FLAG_PATH = os.path.join(STATE_HOME, "omarchy", "toggles", "bar-off")
# What ships. A user's own files live outside the checkout and win or lose
# per name according to the assets mode; lib/battle_assets.py is the whole of
# that decision, and `hyprbattles-ctl assets` prints what it came to.
ASSETS = battle_assets.GENERATED

# What Demon Slayer's Hyprscroll2D posts whenever a move swaps two windows
# instead of stepping into an empty cell, whatever asked for the move. That
# layout is a private fork nobody else has, so it is a shortcut rather than a
# requirement: `hyprbattles-ctl move` sees the same swap on any layout, by looking
# at the window list either side of the move.
LAYOUT_COLLISION_EVENT = "me.schafman.omarchy.plugin.hyprscroll2d:collision"
# And the gamepad plugin's narrower version of the same thing, posted only
# when the pad caused it. Listened for as well, so a pad-driven battle knows
# it is pad-driven; the two are de-duplicated below, because for a d-pad move
# both arrive.
PAD_COLLISION_EVENT = "dev.cstav.omarchy.plugin.hyprscroll2d-gamepad:collision"
# How long the two reports of one collision can be apart.
COLLISION_DEDUP = 0.5

BATTLE_COOLDOWN = 6.0       # quiet period after one, so they do not stack
# How often every open window is written down again. Slow on purpose: the
# only thing it catches that `openwindow` does not is a window that has
# *become* something else - a terminal somebody has since started an agent
# in - and nothing is lost by hearing about that a minute late.
CENSUS_INTERVAL = 60.0
# A wild window appeared: both motors flat out for a second. The gamepad
# daemon caps what a client may ask for, so this is close to that ceiling.
ENCOUNTER_RUMBLE_MS = 1000
RENEW_INTERVAL = 1.5        # lease renewals, comfortably inside the pad's TTL
CLIENT_NAME = "hyprbattles"


def log(message):
    print("hyprbattles: %s" % message, file=sys.stderr, flush=True)


# -------------------------------------------------------------------- sound

# What loops a player that cannot loop by itself: run it again until it
# fails, so a deleted file cannot spin forever. It used to be a line of
# shell; it is Python now, run by the same fixed interpreter the daemon is,
# because the daemon starts nothing that takes its orders from $PATH or the
# environment - see lib/tools.py.
LOOP = "import subprocess, sys\nwhile subprocess.call(sys.argv[1:]) == 0:\n    pass\n"


class Sound:
    """One audio channel: plays a file, and stops it again.

    Two of these run at once - one for the music, one for the one-shots - so a
    hit lands over the theme instead of cutting it off.

    The player is whichever of the usual suspects is installed. With none of
    them, or with a missing file, battles are silent; neither is a reason to
    refuse a battle.
    """

    def __init__(self, assets=None, custom=None):
        # Two directories, not one: what shipped, and whatever the user put in
        # their config. Which of the two a given name comes from is decided
        # per play, so `hyprbattles-ctl assets custom` takes effect on the next
        # sound rather than on the next shell restart.
        self.assets = ASSETS if assets is None else assets
        self.custom = battle_assets.custom_dir() if custom is None else custom
        self.process = None

    def resolve(self, name):
        """The file this name plays from, or None if nothing is there."""
        return battle_assets.resolve(name, generated=self.assets,
                                     custom=self.custom)

    @staticmethod
    def command(path, loop):
        """The first available player, as an argv, or None.

        Players are found by lib/tools.py in a fixed list of root's
        directories, never on $PATH, and every argv here starts with an
        absolute path to one.
        """
        mpv = tools.find("mpv")
        if mpv:
            argv = [mpv, "--no-video", "--no-terminal", "--really-quiet",
                    "--volume=55"]
            if loop:
                argv.append("--loop=inf")
            return argv + [path]
        for name in ("pw-play", "paplay", "aplay"):
            player = tools.find(name)
            if player:
                python = tools.find("python3")
                if not loop or not python:
                    return [player, path]
                # None of these loop on their own; LOOP re-runs it.
                return [python, "-I", "-c", LOOP, player, path]
        return None

    def play(self, name, loop=False):
        self.stop()
        path = self.resolve(name)
        if path is None:
            return
        argv = self.command(path, loop)
        if not argv:
            return
        try:
            # Its own session, so stopping the music kills the shell loop as
            # well as the player it started - and a death signal on top, so a
            # daemon that is killed outright cannot leave the theme playing
            # over a desktop with no battle on it.
            self.process = subprocess.Popen(
                argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                env=tools.environment(),
                start_new_session=True, preexec_fn=die_with_parent)
        except OSError as error:
            log("cannot play %s: %s" % (name, error))
            self.process = None

    def sweep(self):
        """Kill players left over by an earlier daemon.

        The shell restarts this on every reload, and a SIGKILL skips shutdown
        entirely. Matching on our own assets directories keeps this to players
        we started - both of them, because the file a player was given may
        have come from either.
        """
        pkill = tools.find("pkill")
        if not pkill:
            return
        try:
            for directory in (self.assets, self.custom):
                subprocess.run([pkill, "-f",
                                os.path.join(directory, "battle-")],
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL,
                               env=tools.environment(), timeout=2)
        except (OSError, subprocess.SubprocessError):
            pass

    def stop(self):
        process, self.process = self.process, None
        if not process or process.poll() is not None:
            return
        try:
            os.killpg(os.getpgid(process.pid), signal.SIGTERM)
        except OSError:
            try:
                process.terminate()
            except OSError:
                pass
        # Reap it, or every battle leaves a zombie behind for the lifetime of
        # the shell. This event loop never waits on anything else.
        try:
            process.wait(timeout=1)
        except (OSError, subprocess.SubprocessError):
            pass


# ------------------------------------------------------------- borrowing the pad

class PadLease:
    """The gamepad plugin's lending API, from the borrower's side.

    `grab` asks for the controller, `renew` keeps it, `release` gives it back,
    and in between every button and direction arrives on this socket as one
    JSON datagram. The lease has a TTL at the far end, so a crash here gives
    the pad back on its own within a couple of seconds - which is the point of
    a lease rather than a handover.
    """

    def __init__(self, path=GAMEPAD_SOCKET, name=CLIENT_NAME):
        self.path = path
        self.name = name
        self.socket = None
        self.held = False
        self.renew_at = 0.0

    def open(self):
        if self.socket:
            return self.socket
        try:
            client = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
            client.bind("")             # abstract autobind: a reply can land
            client.setblocking(False)
            self.socket = client
        except OSError as error:
            log("cannot open a socket for the pad: %s" % error)
            self.socket = None
        return self.socket

    def send(self, message):
        client = self.open()
        if not client:
            return False
        try:
            client.sendto(message.encode(), self.path)
            return True
        except OSError:
            # The gamepad daemon is not running. That is a normal state, not
            # an error: this plugin simply has no controller to play with.
            return False

    def rumble(self, strong, weak, milliseconds):
        """Ask the gamepad daemon for a buzz. The motors live on its side of
        the socket, and no lease is needed to ask - see its docs/PAD-API.md.
        Silent when that plugin is not installed, like everything else here."""
        return self.send("rumble %.2f %.2f %d" % (strong, weak, milliseconds))

    def grab(self, now):
        if self.send("grab " + self.name):
            self.held = True
            self.renew_at = now + RENEW_INTERVAL
            return True
        return False

    def release(self):
        if self.held:
            self.send("release " + self.name)
        self.held = False

    def tick(self, now):
        if self.held and now >= self.renew_at:
            if not self.send("renew " + self.name):
                self.held = False
            self.renew_at = now + RENEW_INTERVAL

    def read(self):
        """Every event waiting on the socket, as dicts."""
        events = []
        if not self.socket:
            return events
        while True:
            try:
                data, sender = self.socket.recvfrom(4096)
            except (BlockingIOError, OSError):
                return events
            # This socket has no name on disk and so no permission bits:
            # anything on the machine can find it in /proc/net/unix and
            # post to it. The pad daemon answers from its own bound path,
            # so only that path gets to press buttons here.
            if sender != self.path:
                continue
            try:
                events.append(json.loads(data.decode(errors="replace")))
            except ValueError:
                continue        # not ours, or truncated; the next one will be

    def close(self):
        self.release()
        if self.socket:
            try:
                self.socket.close()
            except OSError:
                pass
            self.socket = None


# ------------------------------------------------------------------- daemon

class Daemon:
    def __init__(self):
        self.hypr = hyprland.Hyprland()
        # Where the state file and the control socket go, opened on first
        # use and kept: see runtime() below.
        self.runtime_dir = RUNTIME_DIR
        self.runtime_fd = None
        # Bar toggles and notifiers still to be reaped; see set_bar.
        self._bar_toggles = []
        self._notifiers = []
        self.sound = Sound()
        # One-shots need a channel of their own: play() stops whatever that
        # channel is already playing, which is right for the music and wrong
        # for a hit that has to land over the top of it.
        self.effects = Sound()
        self.pad = PadLease()
        # The pantry is read-only: it reads counters out of /proc and writes
        # nothing but its own ledger. Nothing is dropped, freed or killed.
        self.pantry = pantry.Pantry(ledger=pantry.Ledger(LEDGER_PATH))
        # Levels, wins and appetites. Read on every roster and every feed
        # rather than cached: `hyprbattles-ctl` writes the same file, and a menu
        # that disagrees with the daemon would be a second answer.
        self.creatures = creatures.Store(CREATURES_PATH)
        self.selector = selectors.DefaultSelector()

        self.battle = None
        # The other thing the overlay can be showing: an evolution, which is
        # not a battle and cannot be played. Only ever one of the two is up.
        self.scene = None
        self.source = "layout"
        # Which of the two ways in was last used, so the overlay can label the
        # controls with the buttons that are actually under the player's
        # hands rather than with both sets at once. Either may take over
        # mid-fight - the pad is always grabbed, whoever started the battle.
        self.input = "keys"
        # Which family of move command put the two windows where they are, so
        # a lost battle is undone by the same one running backwards. See
        # lib/window_moves.py; a collision announced by a layout plugin is by
        # definition that layout's own message.
        self.move_style = "layout"
        self.rng = random.Random()
        self.chance = rules.BATTLE_CHANCE
        self.quiet_until = 0.0
        self.published = None
        self.bar_hidden = False
        # The last collision acted on, so the layout's report and the gamepad
        # plugin's report of the same one do not both roll the dice.
        self.last_collision = None
        self.last_collision_at = 0.0

        self.event_stream = None
        self.event_buffer = b""
        self.event_retry = 0.0
        self.control_socket = None
        self.pad_registered = False
        # When the roll call comes round again; see census().
        self.census_at = 0.0

    # ------------------------------------------------------------ enabled

    @staticmethod
    def enabled():
        """The bar widget's switch. Checked before the roll, and it is only a
        stat() - cheap enough to do on every collision rather than caching a
        value that a click could make stale."""
        return not os.path.exists(DISABLED_FLAG)

    @staticmethod
    def reached():
        """Whether a move has ever reached the plugin on this machine.

        A stat(), like enabled(), and read on the same terms: the panel asks
        on every refresh and the answer is a file so that the CLI - which
        runs with the shell down - can write it."""
        return os.path.exists(REACHED_FLAG)

    @staticmethod
    def note_reached():
        """Write that down, once and for good.

        Only the first one costs anything: after that the file is there and
        the existence check short-circuits, so this sits in the collision
        path without being a write per collision. Nothing ever removes it -
        a key that worked in March is proof enough in June, and a plugin
        that forgot would start nagging somebody who had already done it."""
        if os.path.exists(REACHED_FLAG):
            return
        try:
            os.makedirs(os.path.dirname(REACHED_FLAG), exist_ok=True)
            open(REACHED_FLAG, "w").close()
        except OSError as error:
            log("cannot write down that a move arrived: %s" % error)

    def set_enabled(self, wanted):
        try:
            if wanted:
                os.unlink(DISABLED_FLAG)
            else:
                os.makedirs(os.path.dirname(DISABLED_FLAG), exist_ok=True)
                open(DISABLED_FLAG, "w").close()
        except OSError as error:
            log("cannot remember the setting: %s" % error)
        if not wanted and self.battle:
            # Switching it off mid-fight ends the fight, rather than leaving
            # one running that the switch says cannot happen.
            self.battle.flee(time.monotonic())
            self.publish()
        self.publish()

    # ------------------------------------------------------------ triggers

    def on_collision(self, payload, now, source="layout"):
        """A move swapped two windows. Roll for it.

        Both the layout plugin and the gamepad plugin report the same d-pad
        collision, so the pair is de-duplicated on the payload: whichever
        arrives first rolls, and the other is ignored. That keeps the odds at
        one in four per collision rather than one in four per report.
        """
        parts = [part.strip() for part in payload.split(",")]
        if len(parts) < 2 or not parts[0] or not parts[1]:
            return
        if source != "move":
            # A layout or pad plugin announced this one, so the plugin is
            # wired to something whatever the keys are bound to. move() marks
            # its own path, and marks it on every move rather than only on a
            # collision: a bound key that has not landed on anybody yet is
            # still a bound key.
            self.note_reached()
        key = tuple(parts[:3])
        if (self.last_collision == key
                and now - self.last_collision_at < COLLISION_DEDUP):
            return
        self.last_collision = key
        self.last_collision_at = now

        if self.battle or now < self.quiet_until or not self.enabled():
            return
        if not rules.should_battle(self.rng, self.chance):
            return
        if source != "move":
            # Announced by a layout plugin, so the swap was that layout's own
            # move message. move() has already said which style it used.
            self.move_style = "layout"
        self.start(parts[0], parts[1],
                   parts[2] if len(parts) > 2 else "", now, source)

    def layout(self):
        """The layout in use, as lib/window_moves.py names them."""
        return moves.layout_name(self.hypr.query("getoption general:layout"))

    def move(self, direction, now):
        """Move the focused window one cell, and roll if it collided.

        This is the trigger path for everybody: bind a direction to
        `hyprbattles-ctl move <direction>` and the daemon makes the move itself,
        which is how it knows a swap happened without any layout plugin
        telling it. Two window lists, taken either side of the move, are the
        whole of the detection - so dwindle, master and a scrolling layout all
        collide the same way. What is compared is who was next to whom rather
        than where anything was, because a scrolling layout pans the camera
        along with the window it moved.

        The move happens whatever the switch says and whatever the roll comes
        to. A keybind that only worked while battles were on would be a
        keybind nobody could leave bound.
        """
        direction = direction.strip().lower()
        if direction not in moves.DIRECTIONS:
            return False
        self.note_reached()
        active = self.hypr.query("activewindow") or {}
        address = str(active.get("address") or "").lower()
        before = moves.placement(self.hypr.query("clients") or [])
        for style in moves.order(self.layout()):
            self.hypr.dispatch(moves.command(style, direction))
            after = moves.placement(self.hypr.query("clients") or [])
            if after == before:
                # That layout does not speak this style: a message it does not
                # understand moves nothing at all, so the other style gets its
                # turn. Only one of the two can ever land.
                continue
            partner = moves.swapped(address, direction, before, after)
            if partner:
                self.move_style = style
                self.on_collision("%s,%s,%s" % (address, partner, direction),
                                  now, "move")
            return True
        return False

    @staticmethod
    def window_by_address(address, clients):
        for client in clients:
            if str(client.get("address") or "").lower() == address.lower():
                return client
        return None

    def monitor_name(self, client=None, named=""):
        """The monitor to draw on, by name, so the overlay can pick a screen:
        the one `named`, when Hyprland has one by that name, else the one a
        window is on (Hyprland reports that as an id in `clients`), else the
        focused one."""
        monitors = self.hypr.query("monitors") or []
        for monitor in monitors:
            if named and str(monitor.get("name") or "") == named:
                return named
        for monitor in monitors:
            if client and monitor.get("id") == client.get("monitor"):
                return str(monitor.get("name") or "")
        for monitor in monitors:
            if monitor.get("focused"):
                return str(monitor.get("name") or "")
        return ""

    def start(self, challenger_address, defender_address, direction, now,
              source="layout"):
        """Build both creatures and put the overlay up. Never fatal."""
        try:
            clients = self.hypr.query("clients") or []
            challenger = self.window_by_address(challenger_address, clients)
            defender = self.window_by_address(defender_address, clients)
            if not challenger or not defender:
                return
            self.creatures.load()
            fight = rules.Battle(
                rules.creature(challenger, self.creatures.record(challenger)),
                rules.creature(defender, self.creatures.record(defender)),
                now, direction=direction,
                monitor=self.monitor_name(challenger),
                larder=self.pantry)
            # Who fought, so the result can be written down against the right
            # class once it is over. The creature only carries a name.
            fight.challenger_window = challenger
            fight.defender_window = defender
        except Exception as error:
            log("battle could not start: %s" % error)
            return

        self.battle = fight
        self.scene = None
        self.source = source
        # A d-pad collision was made with a pad in hand; everything else -
        # a key bound to `hyprbattles-ctl move`, the layout plugin, debug - was
        # not, until a button says otherwise.
        self.input = "pad" if source == "pad" else "keys"
        # Always ask for the controller, even for a battle a keyboard started:
        # the pad may well be sitting there, and a battle you can finish with
        # either hand is better than one tied to whichever you began with. A
        # failed grab simply means keyboard only.
        self.pad.grab(now)
        # A second of both motors flat out, the way an encounter should land.
        # It goes out whether or not the grab succeeded: the pad may be lent
        # elsewhere or the battle may have been started from the keyboard, and
        # a buzz is harmless either way.
        self.pad.rumble(1.0, 1.0, ENCOUNTER_RUMBLE_MS)
        # The bar belongs to the desktop, and for the next minute this is not
        # the desktop. Left alone if the user already had it hidden.
        self.bar_hidden = not os.path.exists(BAR_FLAG_PATH)
        if self.bar_hidden:
            self.set_bar(False)
        self.sound.play("battle-theme.wav", loop=True)
        self.publish()

    def end(self, now):
        """Take the overlay down and apply the result, once and only once."""
        fight = self.battle
        self.battle = None
        self.quiet_until = now + BATTLE_COOLDOWN
        self.pad.release()
        self.sound.stop()
        self.effects.stop()
        if self.bar_hidden:
            self.set_bar(True)
            self.bar_hidden = False
        self.publish()
        if not fight:
            return

        # The swap already happened when the move landed, so a win needs no
        # work: the challenger is standing on the contested cell. A loss puts
        # it back where it came from, which is the same swap run backwards.
        # Nothing else can happen to either window, whatever the result.
        if fight.result == "loss" and fight.direction:
            command = moves.command(self.move_style,
                                    moves.OPPOSITES.get(fight.direction, ""))
            if command:
                self.hypr.dispatch(command)
                # The one result that puts a window somewhere the person did
                # not ask for it to be. The overlay is gone by now, so the
                # notification is the only thing left to say why.
                self.notify(
                    "%s was beaten" % fight.player.get("name", "Your window"),
                    "Your program had retreated to its original position...")

        self.award(fight, now)

    def award(self, fight, now):
        """Write a finished battle down against both classes, and put an
        evolution on screen if the experience bought one.

        A fled battle is worth nothing to anybody, which is the same thing a
        flee has always meant: it never happened.
        """
        if fight.result not in ("win", "loss"):
            return
        evolutions = []
        try:
            challenger = getattr(fight, "challenger_window", None)
            defender = getattr(fight, "defender_window", None)
            player = getattr(fight, "player", None) or {}
            foe = getattr(fight, "foe", None) or {}
            pairs = ((challenger, player, foe, fight.result),
                     (defender, foe, player,
                      "win" if fight.result == "loss" else "loss"))
            self.creatures.load()
            for window, side, other, result in pairs:
                if not window:
                    continue
                earned = rules.xp_for_result(result, other.get("level", 1))
                before = rules.creature(window, self.creatures.record(window))
                record = self.creatures.award(
                    window, xp=earned,
                    win=1 if result == "win" else 0,
                    loss=1 if result == "loss" else 0)
                after = rules.creature(window, record)
                if after["stage"] > before["stage"]:
                    evolutions.append((window, after))
        except Exception as error:
            log("could not write the result down: %s" % error)
            return

        # One picture, and the challenger's if both crossed: the fight was
        # its idea. The other one still evolved - it is written down either
        # way - it simply does not get the animation.
        if evolutions:
            window, evolved = evolutions[0]
            self.evolve(evolved, now, window=window)

    def evolve(self, evolved, now, window=None, named=""):
        """Put an evolution on screen. Never fatal, and never a battle: it
        holds nothing, moves nothing and can be walked away from.

        It goes where whoever caused it is looking. After a fight that is the
        challenger's screen, where the fight was. After a meal it is the
        screen the panel was open on (`named`), else the focused one - never
        the fed window's, which can be on any monitor, or on none at all once
        it has shut, and a picture on another desk is a picture missed."""
        if self.battle:
            return
        try:
            self.scene = rules.Evolution(
                evolved, evolved["stage"], now,
                monitor=self.monitor_name(window, named))
        except Exception as error:
            log("evolution could not be shown: %s" % error)
            self.scene = None
            return
        self.effects.play("battle-evolve.wav")
        self.publish()

    def tick_scene(self, now):
        scene = self.scene
        if not scene:
            return
        try:
            if scene.tick(now):
                if scene.phase == "done":
                    self.effects.play("battle-levelup.wav")
                self.publish()
            if scene.finished(now):
                self.scene = None
                self.publish()
        except Exception as error:
            log("evolution aborted: %s" % error)
            self.scene = None
            self.publish()

    def set_bar(self, visible):
        # `omarchy-toggle-bar` takes the state of a flag named `bar-off`, not
        # the state of the bar: "on" sets the flag and hides the bar, "off"
        # clears it and brings the bar back.
        #
        # Nothing waits on it, so each call would leave a zombie behind for
        # the life of the daemon - a poor look for the plugin that counts
        # zombies as food. Poll the previous ones on the way past, which
        # reaps the finished without ever blocking.
        self._bar_toggles = [child for child in self._bar_toggles
                             if child.poll() is None]
        toggle = tools.find("omarchy-toggle-bar")
        if not toggle:
            log("no omarchy-toggle-bar; the bar stays where it is")
            return
        try:
            self._bar_toggles.append(subprocess.Popen(
                [toggle, "off" if visible else "on"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                env=tools.environment(), start_new_session=True))
        except OSError as error:
            log("cannot toggle the bar: %s" % error)

    def notify(self, summary, body):
        """Say something on the desktop, for the one outcome that needs it.

        Reaped the way the bar toggles are: nothing waits on a notifier, so
        each one would otherwise leave a zombie behind for the life of the
        daemon - poor form in the plugin that counts zombies as food.

        A missing `notify-send` is not an error. The battle is over and the
        windows are where they belong either way; this is commentary.
        """
        self._notifiers = [child for child in self._notifiers
                           if child.poll() is None]
        notifier = tools.find("notify-send")
        if not notifier:
            return
        try:
            self._notifiers.append(subprocess.Popen(
                [notifier, "-a", "Window Battles",
                 "-i", "input-gaming", summary, body],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                env=tools.environment(), start_new_session=True))
        except OSError as error:
            log("cannot send a notification: %s" % error)

    # -------------------------------------------------------------- input

    def on_pad_event(self, event, now, device="pad"):
        """One forwarded datagram from the gamepad daemon, or the same shape
        of event built out of a keypress by on_key()."""
        kind = event.get("event")
        if kind == "grab" and event.get("state") == "revoked":
            # The pad was taken back - the daemon is stopping, the window
            # grabbed it, or our lease lapsed. Without a controller there is
            # no way to play, so the battle ends rather than sitting there.
            if self.battle:
                log("pad revoked (%s); ending the battle"
                    % (event.get("reason") or "no reason given"))
                self.battle.flee(now)
                self.publish()
            return
        if not self.battle:
            return
        if kind in ("direction", "button") and self.input != device:
            # Picking up the pad mid-fight re-labels the hints, and so does
            # putting it down again. Published on its own because a press
            # that changes nothing else still changed this.
            self.input = device
            self.publish()
        if kind == "direction":
            if self.battle.move_cursor(event.get("direction")):
                self.effects.play("battle-select.wav")
                self.publish()
            return
        if kind != "button" or not event.get("pressed"):
            return

        name = event.get("name")
        if name == "A":
            changed = self.battle.confirm(now)
        elif name == "B":
            # Out of the move list back to FIGHT/RUN, or on with the text.
            changed = self.battle.back(now) or self.battle.advance(now)
        elif name in ("Start", "Select"):
            # The unconditional way out, whatever the odds on RUN say. Press
            # it again once the closing line is up and the battle goes now,
            # rather than sitting through the rest of the dwell.
            changed = self.battle.flee(now)
            if not changed:
                self.end(now)
                return
        else:
            return
        if changed:
            # Every press that did something clicks, before whatever the
            # change itself sounds like.
            self.effects.play("battle-select.wav")
            self.sound_for(self.battle)
            self.publish()

    def sound_for(self, fight):
        """Whatever the last change to the battle should sound like.

        Sounds are asked for by name and never by path: Sound is what turns a
        name into a file, and lib/battle_assets.py is what decides whether
        that file is the generated one or the user's own. Nothing here has to
        know which, which is the point.
        """
        if fight.phase == "over" and fight.result in ("win", "loss"):
            if fight.result == "win":
                # The jingle first, on its own channel, then the fanfare takes
                # the music over - the same order the games this is imitating
                # play them in.
                self.effects.play("battle-levelup.wav")
            self.sound.play("battle-%s.wav"
                            % ("victory" if fight.result == "win" else "defeat"))
        elif fight.effect == "level-up":
            # Eating enough to go up a level, which is what the sting was
            # always for. Over the music, not instead of it: the battle is
            # still going.
            self.effects.play("battle-levelup.wav")
        elif fight.effect == "heal-player":
            self.effects.play("battle-heal.wav")
        elif fight.effect.startswith("hit-"):
            self.effects.play("battle-hit.wav")

    def tick_battle(self, now):
        fight = self.battle
        if not fight:
            return
        try:
            if fight.tick(now):
                self.sound_for(fight)
                self.publish()
            if fight.finished(now):
                self.end(now)
        except Exception as error:
            # A bug in the rules must not take the daemon with it, and must
            # not strand the overlay on screen either.
            log("battle aborted: %s" % error)
            self.battle = None
            self.end(now)

    # ------------------------------------------------------------ publish

    def state(self):
        if not self.battle:
            if self.scene:
                snapshot = self.scene.snapshot()
                snapshot["enabled"] = self.enabled()
                return snapshot
            return {"active": False, "enabled": self.enabled()}
        snapshot = self.battle.snapshot()
        snapshot["enabled"] = True
        # Wiring, not a rule: which device is in the player's hands is not
        # something lib/battle_rules.py has any business knowing.
        snapshot["input"] = self.input
        return snapshot

    def runtime(self):
        """The directory the state file and the control socket live in, as
        a descriptor: opened once, checked to be this user's own and nobody
        else's to write to, and every file in it made relative to it
        (lib/runtime.py). Raises OSError when there is no such directory
        to be had, and every caller says so and carries on."""
        if self.runtime_fd is None:
            self.runtime_fd = runtime.open_private(self.runtime_dir)
        return self.runtime_fd

    def publish(self):
        state = self.state()
        if state == self.published:
            return
        self.published = state
        try:
            runtime.write(self.runtime(), STATE_NAME, json.dumps(state))
        except OSError as error:
            log("cannot write state: %s" % error)

    def recover(self):
        """Clean up after a daemon that was killed mid-battle.

        shutdown() puts everything back, but a SIGKILL never reaches it, and
        the one piece of collateral that outlives the process is the hidden
        bar. A stale state file saying a battle was running is the only
        evidence left, so it is what the bar is brought back on.
        """
        try:
            stale = json.loads(runtime.read(self.runtime(), STATE_NAME))
        except (OSError, ValueError):
            return
        if stale.get("active"):
            log("recovering from a battle left behind by an earlier daemon")
            self.set_bar(True)

    # ------------------------------------------------------------ control

    def shelves(self):
        """The pantry as the overlay and the panel want it: a live reading,
        read-only, with nothing on it that is not on screen."""
        return [
            {"key": shelf["key"], "name": shelf["name"],
             "note": shelf["note"], "unit": shelf["unit"],
             "kind": shelf["kind"], "portion": shelf["portion"],
             "nourish": shelf.get("nourish", 0),
             "available": shelf["available"], "servings": shelf["servings"]}
            for shelf in self.pantry.stock()
        ]

    def roster(self):
        """Every open window as a creature, and every creature whose window
        is shut. Read-only, like the pantry: the panel can look at every
        window on the machine and touch none of them."""
        try:
            self.creatures.load()
            clients = self.hypr.query("clients") or []
            # Every open window gets a record, whether or not it has ever
            # fought or eaten: without one, closing something that never did
            # either would leave nothing behind to sleep.
            self.creatures.touch(clients)
            return (creatures.roster(clients, self.creatures, self.pantry),
                    creatures.sleeping(clients, self.creatures))
        except Exception as error:
            log("cannot read the roster: %s" % error)
            return [], []

    def census(self, windows=None):
        """Give every window now open a record, so that shutting one leaves
        something behind to sleep.

        A record used to be written only when a window fought, was fed, or
        was looked at through the panel, and `roster()` still writes one for
        everything it sees. That was too late: a window opened and closed
        between two glances at the panel was never anything, so the sleeping
        list only ever held what somebody had happened to be looking at.
        This runs at startup, on every `openwindow`, and on a slow timer -
        the timer because a window is not always what it will be: a terminal
        becomes an agent when you start one in it, minutes after it opened,
        and nothing on the event socket says so.
        """
        try:
            self.creatures.load()
            if windows is None:
                windows = self.hypr.query("clients") or []
            self.creatures.touch(windows)
        except Exception as error:
            log("cannot write down an open window: %s" % error)

    def note_open(self, payload):
        """`openwindow>>address,workspace,class,title`.

        The class rides in the event, so a window opening costs no round trip
        to the compositor - and it is the class at launch, which is the name
        a creature is remembered under anyway.
        """
        parts = payload.split(",")
        if len(parts) < 3:
            return
        name = parts[2].strip()
        if not name:
            return
        self.census([{"initialClass": name, "class": name}])

    def feed(self, address, shelf_key, now, monitor=""):
        """Feed one window from the panel. The one thing in this daemon that
        changes a creature without a fight - and still nothing that changes a
        window. `monitor` is the screen the meal was given from, which is
        where an evolution it buys is shown."""
        try:
            self.creatures.load()
            clients = self.hypr.query("clients") or []
            window = creatures.find(address, clients, self.creatures)
        except Exception as error:
            log("cannot feed: %s" % error)
            return {"ok": False, "message": "The window list is unreadable."}
        if not window:
            return {"ok": False, "message": "That window is gone."}

        # The window list goes in too: a creature is every window of its
        # class, and they share one appetite between them.
        result = creatures.feed(window, shelf_key, self.creatures, self.pantry,
                                clients=clients)
        if not result.get("ok"):
            return result
        self.effects.play("battle-heal.wav")
        if result.get("leveled"):
            self.effects.play("battle-levelup.wav")
        if result.get("evolved"):
            self.evolve(result["creature"], now, named=monitor)
        return result

    def teach(self, address, slot, move):
        """Swap one of a window's four moves. Like feeding, this writes a
        record and touches no window."""
        try:
            self.creatures.load()
            clients = self.hypr.query("clients") or []
            # By address while it is open, by the name it is remembered under
            # once it is not: moves belong to the class, so a shut window is
            # still something you can pick a loadout for.
            window = creatures.find(address, clients, self.creatures)
        except Exception as error:
            log("cannot teach: %s" % error)
            return {"ok": False, "message": "The window list is unreadable."}
        if not window:
            return {"ok": False, "message": "That window is gone."}

        result = creatures.teach(window, slot, move, self.creatures)
        if result.get("ok"):
            self.effects.play("battle-select.wav")
        return result

    def handle_command(self, text):
        parts = text.strip().split()
        verb = parts[0] if parts else "status"
        now = time.monotonic()

        if verb in ("cancel", "stop") and not self.battle and self.scene:
            # Escape during an evolution skips the picture. The level itself
            # was written down before the animation started, so there is
            # nothing here to lose.
            self.scene.flee(now)
            self.scene = None
            self.publish()
        elif verb == "roster":
            rows, asleep = self.roster()
            return {"roster": rows, "sleeping": asleep,
                    "enabled": self.enabled(), "reached": self.reached(),
                    "layoutAnnounces": self.layout() == moves.ANNOUNCES,
                    "pantry": self.shelves()}
        elif verb == "feed":
            return self.feed(parts[1] if len(parts) > 1 else "",
                             parts[2] if len(parts) > 2 else "", now,
                             parts[3] if len(parts) > 3 else "")
        elif verb == "teach":
            return self.teach(parts[1] if len(parts) > 1 else "",
                              parts[2] if len(parts) > 2 else "",
                              parts[3] if len(parts) > 3 else "")
        elif verb == "cancel" and self.battle:
            # Escape. The first one flees; a second one, with the battle
            # already over and only its closing line left on screen, takes
            # the overlay down immediately. The result is applied either way,
            # by end(), so leaving early cannot change what happened.
            if self.battle.flee(now):
                self.publish()
            else:
                self.end(now)
        elif verb == "stop" and self.battle:
            # Harder than cancel: tear it down now, no closing line.
            self.end(now)
        elif verb == "debug":
            self.debug(now)
        elif verb in ("on", "off", "toggle"):
            self.set_enabled(not self.enabled() if verb == "toggle"
                             else verb == "on")
        elif verb == "pantry":
            return {"pantry": self.shelves()}
        elif verb == "move":
            # The layout-agnostic trigger: move the window, and roll if that
            # move landed on somebody. Bound to a key, this replaces whatever
            # move dispatcher was on it.
            self.move(parts[1] if len(parts) > 1 else "", now)
        elif verb == "refresh":
            # Somebody flipped the flag file behind our back (the menu row
            # does exactly that, so it still works with no daemon running).
            # The only thing to do about it is stop a battle that the setting
            # now says cannot be happening.
            if self.battle and not self.enabled():
                self.battle.flee(now)
            self.publish()
        elif verb == "key" and self.battle:
            # The overlay's keyboard, mapped onto the same handlers the
            # controller goes through, so there is one set of battle controls
            # rather than two that can drift apart.
            self.on_key(parts[1] if len(parts) > 1 else "", now)
        elif verb in ("pick", "advance") and self.battle:
            # Debug aids, so the overlay can be driven and screenshotted from
            # a script with no controller in anyone's hands.
            if verb == "advance":
                if self.battle.advance(now):
                    self.publish()
            else:
                try:
                    index = int(parts[1]) if len(parts) > 1 else 0
                except ValueError:
                    index = 0
                if self.battle.phase == "action":
                    self.battle.cursor = 0
                    self.battle.confirm(now)
                if self.battle.play(index, now) or self.battle.advance(now):
                    self.sound_for(self.battle)
                    self.publish()
        return self.state()

    # Keyboard names to the forwarded-controller events they stand in for.
    KEYS = {
        "left": ("direction", "l"), "right": ("direction", "r"),
        "up": ("direction", "u"), "down": ("direction", "d"),
        "confirm": ("button", "A"), "back": ("button", "B"),
        "leave": ("button", "Start"),
    }

    def on_key(self, name, now):
        mapped = self.KEYS.get(name)
        if not mapped:
            return
        kind, value = mapped
        if kind == "direction":
            self.on_pad_event({"event": "direction", "direction": value}, now,
                              "keys")
        else:
            self.on_pad_event({"event": "button", "name": value,
                               "pressed": True}, now, "keys")

    def debug(self, now):
        """Force a battle between the focused window and its neighbour.

        It passes no direction, so there is nothing to put back when it ends:
        a forced battle cannot move anything whichever way it goes. It works
        without a 2D workspace and without a pad.
        """
        if self.battle or not self.enabled():
            # Off means off, including here. A debug trigger that quietly
            # ignored the switch would be the one way to get a battle while
            # the bar widget says none can happen.
            return
        active = self.hypr.query("activewindow") or {}
        clients = self.hypr.query("clients") or []
        address = str(active.get("address") or "")
        others = [client for client in clients
                  if str(client.get("address") or "") != address
                  and client.get("monitor") == active.get("monitor")
                  and client.get("mapped")]
        if not address or not others:
            return
        self.start(address, str(others[0].get("address")), "", now)

    # --------------------------------------------------------- event loop

    def bind_control(self):
        # The directory is checked before anything is put in it, and the
        # stale name is removed as a name - a link somebody left there goes,
        # not what it points at. bind() takes a path, there being no way to
        # bind relative to a descriptor, so the socket node itself is made
        # under a mask that leaves it readable and writable by this user
        # only; the directory is already nobody else's.
        directory = self.runtime()
        runtime.remove(directory, SOCKET_NAME)
        server = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        mask = os.umask(0o077)
        try:
            server.bind(os.path.join(self.runtime_dir, SOCKET_NAME))
        finally:
            os.umask(mask)
        server.setblocking(False)
        self.control_socket = server
        self.selector.register(server, selectors.EVENT_READ, "control")

    def read_control(self):
        try:
            data, address = self.control_socket.recvfrom(4096)
        except (BlockingIOError, OSError):
            return
        state = self.handle_command(data.decode(errors="replace"))
        if address:
            try:
                self.control_socket.sendto(json.dumps(state).encode(), address)
            except OSError:
                pass

    def connect_events(self):
        try:
            stream = self.hypr.events()
        except OSError as error:
            log("no Hyprland event socket (%s); retrying" % error)
            self.event_stream = None
            self.event_retry = time.monotonic() + 2.0
            return
        stream.setblocking(False)
        self.event_stream = stream
        self.event_buffer = b""
        self.selector.register(stream, selectors.EVENT_READ, "hypr")

    def drop_events(self):
        if not self.event_stream:
            return
        try:
            self.selector.unregister(self.event_stream)
        except (KeyError, ValueError):
            pass
        self.event_stream.close()
        self.event_stream = None
        self.event_retry = time.monotonic() + 1.0

    def read_events(self):
        try:
            chunk = self.event_stream.recv(8192)
        except BlockingIOError:
            return
        except OSError:
            chunk = b""
        if not chunk:
            self.drop_events()
            return
        self.event_buffer += chunk
        lines = self.event_buffer.split(b"\n")
        self.event_buffer = lines.pop()
        now = time.monotonic()
        for line in lines:
            name, _, data = line.decode(errors="replace").partition(">>")
            if name == "openwindow":
                # A surprise in the payload must not cost the event loop
                # here either.
                try:
                    self.note_open(data)
                except Exception as error:
                    log("window not written down: %s" % error)
                continue
            if name != "custom":
                continue
            for event, source in ((PAD_COLLISION_EVENT, "pad"),
                                  (LAYOUT_COLLISION_EVENT, "layout")):
                if not data.startswith(event + ","):
                    continue
                # A surprise in the payload must not cost the event loop.
                try:
                    self.on_collision(data[len(event) + 1:], now, source)
                except Exception as error:
                    log("collision ignored: %s" % error)
                break

    def read_pad(self):
        now = time.monotonic()
        for event in self.pad.read():
            try:
                self.on_pad_event(event, now)
            except Exception as error:
                log("pad event ignored: %s" % error)

    def next_timeout(self, now):
        deadlines = []
        if self.battle:
            deadline = self.battle.deadline()
            if deadline is not None:
                deadlines.append(deadline)
        if self.scene:
            deadline = self.scene.deadline()
            if deadline is not None:
                deadlines.append(deadline)
        if self.pad.held:
            deadlines.append(self.pad.renew_at)
        deadlines.append(self.census_at)
        if not self.event_stream:
            deadlines.append(self.event_retry)
        if not deadlines:
            return 1.0
        return max(0.0, min(min(deadlines) - now, 1.0))

    def run(self):
        set_parent_death_signal()
        self.bind_control()
        self.connect_events()
        self.sound.sweep()
        self.recover()
        # Everything already open when the daemon starts, so a machine that
        # has never had the panel opened still knows what it is running.
        self.census()
        self.census_at = time.monotonic() + CENSUS_INTERVAL
        # Write "no battle" once at startup: the overlay watches this file,
        # and a watch on a path that does not exist yet never fires.
        self.publish()

        while True:
            # The lease socket is opened the first time the pad is asked
            # for, so it is registered here rather than once at startup.
            if self.pad.socket and not self.pad_registered:
                try:
                    self.selector.register(self.pad.socket,
                                           selectors.EVENT_READ, "pad")
                    self.pad_registered = True
                except (KeyError, ValueError):
                    pass

            now = time.monotonic()
            for key, _ in self.selector.select(self.next_timeout(now)):
                if key.data == "control":
                    self.read_control()
                elif key.data == "hypr":
                    self.read_events()
                elif key.data == "pad":
                    self.read_pad()

            now = time.monotonic()
            self.pad.tick(now)
            self.tick_battle(now)
            self.tick_scene(now)
            if now >= self.census_at:
                # Never during a fight: the roll call is a window list and a
                # tree of /proc reads, and nothing but the battle should be
                # using the machine while the battle is on screen.
                self.census_at = now + CENSUS_INTERVAL
                if not self.battle and not self.scene:
                    self.census()
            if not self.event_stream and now >= self.event_retry:
                self.connect_events()

    def shutdown(self):
        # A battle must not outlive the daemon: give the pad and the bar back,
        # stop the music, and clear the file the overlay watches so it cannot
        # be left holding the keyboard over a desktop with nothing driving it.
        self.battle = None
        self.scene = None
        try:
            self.end(time.monotonic())
        except Exception:
            self.sound.stop()
            self.effects.stop()
        self.pad.close()
        try:
            directory = self.runtime()
            for name in (SOCKET_NAME, STATE_NAME):
                runtime.remove(directory, name)
        except OSError:
            pass


def die_with_parent():
    """preexec hook: ask the kernel to SIGTERM this child when we exit."""
    try:
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        libc.prctl(PR_SET_PDEATHSIG, signal.SIGTERM, 0, 0, 0)
    except (OSError, AttributeError):
        pass


def set_parent_death_signal():
    """Die with omarchy-shell, so disabling the plugin stops the daemon."""
    die_with_parent()


def already_running():
    """True when another daemon answers on the control socket."""
    if not os.path.exists(SOCKET_PATH):
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as probe:
            probe.bind("")          # abstract autobind, so a reply can land
            probe.settimeout(0.4)
            probe.sendto(b"status", SOCKET_PATH)
            # Only the daemon's own bound path counts as an answer: the
            # probe is an abstract socket anyone local can post to.
            deadline = time.monotonic() + 0.4
            while time.monotonic() < deadline:
                _, sender = probe.recvfrom(4096)
                if sender == SOCKET_PATH:
                    return True
        return False
    except OSError:
        return False


def main(argv):
    for argument in argv[1:]:
        if argument in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        log("unknown argument: %s" % argument)
        return 2

    if already_running():
        log("another daemon is already running")
        return 0

    daemon = Daemon()

    def stop(*_):
        daemon.shutdown()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        daemon.run()
    except KeyboardInterrupt:
        pass
    finally:
        daemon.shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
